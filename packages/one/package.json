{
  "name": "@sirdab/one",
  "version": "0.1.0-alpha.0",
  "description": "The design system by Sirdab. React components, light and dark themes, and Arabic support.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirdab/one.git",
    "directory": "packages/one"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "licenses",
    "README.md",
    "TOKENS.md",
    "COLORS.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./foundation": {
      "types": "./dist/foundation/index.d.ts",
      "import": "./dist/foundation/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./theme-provider": {
      "types": "./dist/theme-provider.d.ts",
      "import": "./dist/theme-provider.js"
    },
    "./components/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js"
    },
    "./icons/*": {
      "types": "./dist/components/icons/*.d.ts",
      "import": "./dist/components/icons/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./tailwind.css": "./src/foundation/tailwind.css",
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "one"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:tokens": "node scripts/lint-tokens.mjs src/components"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.5.0",
    "next-themes": "^0.4.6",
    "radix-ui": "1.8.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.2",
    "react-dropzone": "^20.1.4",
    "react-easy-crop": "^6.2.4",
    "react-resizable-panels": "^4.14.6",
    "streamdown": "^2.7.0",
    "use-stick-to-bottom": "^1.1.6",
    "tw-animate-css": "^1.4.0",
    "@radix-ui/react-dialog": "1.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
